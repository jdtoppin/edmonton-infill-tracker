# Core application
APP_URL=http://localhost:3000
AUTH_REQUIRED=true
NODE_ENV=development

# PostgreSQL / PostGIS
POSTGRES_DB=infill
POSTGRES_USER=infill
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://infill:replace-with-a-long-random-password@localhost:5432/infill?schema=public

# Initial administrator. The Mac installer passes the password only to the
# one-time bootstrap container; leave it blank in the long-lived environment.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=
RESET_INITIAL_ADMIN_PASSWORD=false

# Development-only synthetic seed accounts. Set unique local values before
# explicitly running the development seed command.
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=

# Edmonton Open Data / Socrata
EDMONTON_SOCRATA_BASE_URL=https://data.edmonton.ca/resource
EDMONTON_DEVELOPMENT_PERMITS_DATASET_ID=2ccn-pwtu
EDMONTON_BUILDING_PERMITS_DATASET_ID=24uj-dj8v
SOCRATA_APP_TOKEN=
IMPORT_PAGE_SIZE=1000
IMPORT_RATE_LIMIT_PER_SECOND=4
IMPORT_RETRY_LIMIT=4
IMPORT_REQUEST_TIMEOUT_MS=30000
IMPORT_MAX_RESPONSE_BYTES=25000000

# Classification
INFILL_HIGH_VALUE_THRESHOLD=500000
# Maximum lookback from the latest qualifying milestone in one infill episode.
# Use 457 for a more aggressive roughly 15-month policy.
INFILL_EPISODE_GAP_DAYS=548

# Map basemap. These URLs are sent to the browser and must not contain secrets.
# The default uses OpenStreetMap's standard interactive tile service with no API key.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional HTTPS MapLibre-compatible style URL. When set, it replaces MAP_TILE_URL.
MAP_STYLE_URL=

# Daily email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=infill@example.com

# Optional mobile alerts
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Background services
WORKER_POLL_INTERVAL_MS=15000
WORKER_JOB_LEASE_MS=120000
SCHEDULER_INTERVAL_MS=86400000

# Optional error reporting
SENTRY_DSN=

# Docker / Mac mini hosting. Production stays on loopback; Tailscale Serve
# publishes HTTP_PORT privately to the tailnet and terminates HTTPS. The
# installer owns only the selected Serve port and never resets other routes.
APP_IMAGE_TAG=local
HOST_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80
# Match the client-facing scheme. The guided Tailscale installer sets https.
UPSTREAM_FORWARDED_PROTO=http
TAILSCALE_SERVE_HTTPS_PORT=443
TAILSCALE_SERVE_MANAGED=false
