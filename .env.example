# Core application
APP_URL=http://localhost:3000
AUTH_REQUIRED=true
NODE_ENV=development

# PostgreSQL / PostGIS
POSTGRES_DB=infill
POSTGRES_USER=infill
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://infill:replace-with-a-long-random-password@localhost:5432/infill?schema=public

# Initial local accounts (change every placeholder before non-local use)
INITIAL_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-at-least-16-characters
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=replace-with-at-least-16-characters

# Edmonton Open Data / Socrata
EDMONTON_SOCRATA_BASE_URL=https://data.edmonton.ca/resource
EDMONTON_DEVELOPMENT_PERMITS_DATASET_ID=2ccn-pwtu
EDMONTON_BUILDING_PERMITS_DATASET_ID=24uj-dj8v
SOCRATA_APP_TOKEN=
IMPORT_PAGE_SIZE=1000
IMPORT_RATE_LIMIT_PER_SECOND=4
IMPORT_RETRY_LIMIT=4

# Classification
INFILL_HIGH_VALUE_THRESHOLD=500000

# Mapbox (the NEXT_PUBLIC token is intentionally browser-visible)
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12

# Daily email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=infill@example.com

# Optional mobile alerts
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Background services
WORKER_POLL_INTERVAL_MS=15000
SCHEDULER_INTERVAL_MS=3600000

# Optional error reporting
SENTRY_DSN=

# Docker / local-network hosting
APP_IMAGE_TAG=local
HTTP_PORT=80
HTTPS_PORT=443
SITE_ADDRESS=:80
